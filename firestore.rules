rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // COLEÇÃO DE ATIVIDADES MATHQUEST
    // ==========================================
    match /atividades_mathquest/{document=**} {
      // Leitura pública, escrita requer autenticação
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ==========================================
    // COLEÇÃO DE PROVA DE LÓGICA DE PROGRAMAÇÃO
    // ==========================================
    match /prova_logica_programacao/{document=**} {
      // Leitura pública, escrita requer autenticação
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // ==========================================
    // COLEÇÃO DE JOGOS (games)
    // Acesso exclusivo via API Admin (server). Clientes NÃO acessam direto.
    // ==========================================
    match /games/{gameId} {
      allow read, write: if false;
    }
    
    // ==========================================
    // COLEÇÃO DE COMENTÁRIOS (comments)
    // Acesso exclusivo via API Admin (server).
    // ==========================================
    match /comments/{commentId} {
      allow read, write: if false;
    }
    
    // ==========================================
    // COLEÇÃO DE FAVORITOS (favorites)
    // Acesso exclusivo via API Admin (server).
    // ==========================================
    match /favorites/{favoriteId} {
      allow read, write: if false;
    }
    
    // ==========================================
    // COLEÇÃO DE VIEWS (views) - Estatísticas
    // Acesso exclusivo via API Admin (server).
    // ==========================================
    match /views/{gameId} {
      allow read, write: if false;
    }
    
    // ==========================================
    // COLEÇÃO DE DOWNLOADS (downloads) - Estatísticas
    // Acesso exclusivo via API Admin (server).
    // ==========================================
    match /downloads/{downloadId} {
      allow read, write: if false;
    }
    
    // ==========================================
    // COLEÇÃO DE RATINGS (ratings) - Avaliações
    // Acesso exclusivo via API Admin (server).
    // ==========================================
    match /ratings/{ratingId} {
      allow read, write: if false;
    }

    // ==========================================
    // COLEÇÃO DE QUESTÕES SAEP (saep_questions)
    // ==========================================
    match /saep_questions/{questionId} {
      // Leitura pública (alunos precisam ler as questões)
      allow read: if true;
      // Escrita requer autenticação (admin/teacher gerencia)
      allow write: if request.auth != null;
    }
    
    // ==========================================
    // COLEÇÃO DE TENTATIVAS SAEP (saep_attempts)
    // ==========================================
    match /saep_attempts/{attemptId} {
      // Leitura pública (ranking é visível para todos)
      allow read: if true;
      // Criação requer autenticação
      allow create: if request.auth != null;
      // Tentativas são imutáveis após criação
      allow update, delete: if false;
    }
    
    // ==========================================
    // OUTRAS COLEÇÕES - Negar tudo por padrão
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

